#!/usr/bin/env bash
# victory-proton: build VIctory (https://github.com/Marvisak/VIctory), or any
# fork of it, for Windows from Linux, and run it with GE-Proton's wine and
# vkd3d-proton, with the game folder mounted read-only. Forks with a native
# Linux runtime (VP_NATIVE=1) are built for Linux and run without wine.
#
# Usage: victory-proton [-p profile] [command] [options]   (victory-proton help)
set -euo pipefail
trap 'printf "\e[1;31m==> error:\e[0m \"%s\" failed (line %d, code %d)\n" "$BASH_COMMAND" "$LINENO" "$?" >&2' ERR

# ---------------------------------------------------------------- locations
CONFIG_DIR=${VP_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/victory-proton}
# Optional shell file with VP_* settings (see the README, "Configuration").
# shellcheck source=/dev/null
[[ -f $CONFIG_DIR/config ]] && source "$CONFIG_DIR/config"
DATA=${VP_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/victory-proton}
PROFILES_FILE=$CONFIG_DIR/profiles   # profiles you added
PROTONS_FILE=$CONFIG_DIR/protons     # the Proton chosen for a profile: NAME PROTON
DEFAULT_FILE=$CONFIG_DIR/profile     # the default profile's name
GAME_FILE=$CONFIG_DIR/game           # the game folder
REPO_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
WS_PATCH_URL=https://raw.githubusercontent.com/datingesp-hash/victory-proton/main/wine/wineserver-view-tree.patch
TARGET=x86_64-pc-windows-msvc
SYNCED=refs/victory-proton/synced    # last upstream commit this script checked out
GE_REPO=GloriousEggroll/proton-ge-custom
GE_MIN=GE-Proton11-13                # older dxil-spirv breaks the first mesh pipeline
export PATH=$HOME/.cargo/bin:$PATH   # rustup's cargo before a system one

# ---------------------------------------------------------------- output
c_info=$'\e[1;36m' c_warn=$'\e[1;33m' c_err=$'\e[1;31m' c_dim=$'\e[2m' c_off=$'\e[0m'
if [[ ! -t 2 ]]; then c_info= c_warn= c_err= c_dim= c_off=; fi
info() { printf '%s==>%s %s\n' "$c_info" "$c_off" "$*" >&2; }
warn() { printf '%s==> warning:%s %s\n' "$c_warn" "$c_off" "$*" >&2; }
die()  { printf '%s==> error:%s %s\n' "$c_err" "$c_off" "$*" >&2; exit 1; }

# The package that provides a command, for the distribution in use.
pkg_hint() {
    local cmd=$1 arch deb fed suse
    case $cmd in
        bwrap)      arch=bubblewrap deb=bubblewrap fed=bubblewrap suse=bubblewrap ;;
        autoreconf) arch=autoconf deb=autoconf fed=autoconf suse=autoconf ;;
        make|gcc)   arch=base-devel deb=build-essential fed='gcc make' suse='gcc make' ;;
        glslangValidator) arch=glslang deb=glslang-tools fed=glslang suse=glslang-devel ;;
        widl)       arch=wine deb=wine64-tools fed=wine-devel suse=wine-devel ;;
        ninja)      arch=ninja deb=ninja-build fed=ninja-build suse=ninja ;;
        python3)    arch=python deb=python3-venv fed=python3 suse=python3 ;;
        lld-link)   arch=lld deb=lld fed=lld suse=lld ;;
        setcap|getcap) arch=libcap deb=libcap2-bin fed=libcap suse=libcap-progs ;;
        cc)         arch=base-devel deb=build-essential fed=gcc suse=gcc ;;
        *)          arch=$cmd deb=$cmd fed=$cmd suse=$cmd ;;
    esac
    if command -v pacman >/dev/null; then echo "sudo pacman -S --needed $arch"
    elif command -v apt-get >/dev/null; then echo "sudo apt install $deb"
    elif command -v dnf >/dev/null; then echo "sudo dnf install $fed"
    elif command -v zypper >/dev/null; then echo "sudo zypper install $suse"
    else echo "install '$arch' with your package manager"; fi
}
need() { local c; for c in "$@"; do command -v "$c" >/dev/null || die "'$c' is missing: $(pkg_hint "$c")"; done; }

# /home/x/y -> Z:\home\x\y (wine maps Z: to /)
winpath() { local p; p=$(realpath -m "$1"); printf 'Z:%s' "${p//\//\\}"; }

# ---------------------------------------------------------------- profiles
# A profile is one VIctory repository and branch. Each has its own checkout,
# build, shader cache, saves and logs under $DATA/profiles/<name>, so
# switching never mixes them. Only the wine prefix (wine + vkd3d-proton,
# which VIctory does not write to) is shared.
#
# Built-in ones; `victory-proton profile add` puts yours in $PROFILES_FILE,
# one per line: NAME URL BRANCH [VAR=VALUE ...]
declare -A P_URL=() P_BRANCH=() P_ENV=() P_ABOUT=()
add_builtin() { P_URL[$1]=$2 P_BRANCH[$1]=$3 P_ENV[$1]=$4 P_ABOUT[$1]=$5; }
add_builtin upstream https://github.com/Marvisak/VIctory main "" \
    "VIctory itself"
add_builtin fxceless https://github.com/fxceless/victory-fork main "VICTORY_NO_WATCHDOG=1" \
    "fork focused on getting the world to render"
add_builtin myokex https://github.com/myokex/victory-amd victory-amd "VICTORY_NO_WATCHDOG=1" \
    "fork of fxceless with AMD fixes"
add_builtin joshuu https://github.com/JoshuuDev/victory-amd victory-amd "VICTORY_NO_WATCHDOG=1" \
    "fork of myokex; fixes DirectStorage reads into guarded memory"
add_builtin copperearth https://github.com/Copperearth/VIctory-wineless main "VP_NATIVE=1 VICTORY_NO_WATCHDOG=1" \
    "native Linux runtime, no wine"
# The settings of its linux/victory-proton.sh (the fork's fast mode, renderer
# ports 1/2/5/6/7, no 30 fps cap). It needs the patched wineserver and the
# huge pages of its linux/thp/ to reach its numbers (~17-19 fps in the world).
KROEEEE_ENV="VICTORY_TEXTURE_NO_WAIT=1 VICTORY_RELAY=2 VICTORY_WIDE_BACK=1 VICTORY_CARD_REHASH_RUNS=1
    VICTORY_JOIN_COPIES=1 VICTORY_INDIRECT_WINDOW=1 VICTORY_RELAY_COPY=1 VICTORY_CARD_STEPS=2
    VICTORY_INDIRECT_BATCH=2 VICTORY_MAP_THREADS=1 VICTORY_TITLE_PRIORITIES=0 VICTORY_CARD_AWAKE=1
    VICTORY_SHOW_AFTER=1 VICTORY_AMBIENT=0.8 VICTORY_D3D12_DRED=light VICTORY_SKIP_PIPELINES=none
    VICTORY_THIN=1 VICTORY_JOIN_PARTS=8 VICTORY_UPLOAD_AHEAD=1
    VICTORY_PORT_DESCRIPTORS=1 VICTORY_PORT_GUARD=1 VICTORY_PORT_JOURNAL=1 VICTORY_PORT_CBV=1
    VICTORY_PORT_CONSTANTS=1 VICTORY_COPY_COMPARE=1 VICTORY_ONE_PAD=0 VICTORY_FRAME_INTERVAL_MS=0
    VKD3D_CONFIG= SDL_GAMECONTROLLER_IGNORE_DEVICES=0x0000/0x0000 SDL_JOYSTICK_IGNORE_DEVICES=0x0000/0x0000"
add_builtin kroeeee https://github.com/kroeeee-eeee/VIctory-Linux-Proton-Wine-7900XT-XTX main "${KROEEEE_ENV//$'\n'/ }" \
    "made for Linux/Proton on AMD RDNA 3 (7900 XT/XTX); the fastest here"
# The GPU a profile was made for; others get a warning, not a refusal.
declare -A P_GPU=([kroeeee]=amd)
BUILTINS=(upstream fxceless myokex joshuu copperearth kroeeee)
DEFAULT_PROFILE=kroeeee

if [[ -f $PROFILES_FILE ]]; then
    while read -r name url branch env; do
        [[ -z $name || $name == \#* ]] && continue
        P_URL[$name]=$url P_BRANCH[$name]=${branch:-main} P_ENV[$name]=${env:-} P_ABOUT[$name]="added by you"
    done <"$PROFILES_FILE"
fi

# github.com/OWNER/REPO[/tree/BRANCH], OWNER/REPO, or any git URL ->
# "URL BRANCH" (BRANCH empty when not given).
parse_repo() {
    local s=$1 branch=
    s=${s%/}
    if [[ $s =~ ^(https?://github\.com/[^/]+/[^/]+)/tree/(.+)$ ]]; then
        s=${BASH_REMATCH[1]} branch=${BASH_REMATCH[2]}
    elif [[ $s =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
        s=https://github.com/$s
    fi
    s=${s%.git}
    printf '%s %s\n' "$s" "$branch"
}

# The branch a remote's HEAD points at.
remote_head() {
    GIT_TERMINAL_PROMPT=0 git ls-remote --symref "$1" HEAD 2>/dev/null | sed -n 's|^ref: refs/heads/\(.*\)\tHEAD$|\1|p' || true
}

profile_add() {
    (($#)) || die "usage: victory-proton profile add URL [NAME] [BRANCH] [VAR=VALUE ...]"
    need git
    local url branch name
    read -r url branch <<<"$(parse_repo "$1")"
    shift
    if (($#)) && [[ $1 != *=* ]]; then name=$1; shift; fi
    if (($#)) && [[ $1 != *=* ]]; then branch=$1; shift; fi
    if [[ -z ${name:-} ]]; then
        # The owner's name; owner-repo if that is taken by another repo.
        local owner repo
        owner=$(basename "$(dirname "$url")" | tr '[:upper:]' '[:lower:]')
        repo=$(basename "$url" | tr '[:upper:]' '[:lower:]')
        name=$owner
        if [[ -n ${P_URL[$name]+x} && ${P_URL[$name]} != "$url" ]]; then name=$owner-$repo; fi
    fi
    local n
    for n in ${name:-} $(printf '%s\n' "${!P_URL[@]}" | sort); do
        if [[ ${P_URL[$n]:-} == "$url" && ( -z $branch || ${P_BRANCH[$n]} == "$branch" ) ]] && (($# == 0)); then
            info "'$n' is a profile already ($url ${P_BRANCH[$n]}). Use it with: victory-proton -p $n"
            ADDED=$n; return
        fi
    done
    [[ $name =~ ^[A-Za-z0-9_.-]+$ ]] || die "a profile name may only have letters, digits, '.', '_' and '-'"
    if [[ -z $branch ]]; then
        branch=$(remote_head "$url")
        [[ -n $branch ]] || die "cannot reach $url (is it public, and spelled right?)"
    elif ! GIT_TERMINAL_PROMPT=0 git ls-remote --exit-code --heads "$url" "$branch" >/dev/null 2>&1; then
        die "$url has no branch '$branch'"
    fi
    mkdir -p "$CONFIG_DIR"
    touch "$PROFILES_FILE"
    local tmp; tmp=$(mktemp)
    awk -v n="$name" '$1 != n' "$PROFILES_FILE" >"$tmp"
    printf '%s %s %s%s\n' "$name" "$url" "$branch" "${*:+ $*}" >>"$tmp"
    mv "$tmp" "$PROFILES_FILE"
    P_URL[$name]=$url P_BRANCH[$name]=$branch P_ENV[$name]="$*"
    info "profile '$name': $url ($branch). Use it with: victory-proton -p $name"
    ADDED=$name
}

profile_remove() {
    local name=${1:-}
    [[ -n $name ]] || die "usage: victory-proton profile remove NAME"
    if [[ ! -f $PROFILES_FILE ]] || ! awk -v n="$name" '$1 == n {f=1} END {exit !f}' "$PROFILES_FILE"; then
        if printf '%s\n' "${BUILTINS[@]}" | grep -qx "$name"; then die "'$name' is built in and cannot be removed"; fi
        die "no profile '$name' of yours"
    fi
    local tmp; tmp=$(mktemp)
    awk -v n="$name" '$1 != n' "$PROFILES_FILE" >"$tmp"
    mv "$tmp" "$PROFILES_FILE"
    info "removed profile '$name'. Its checkout, cache and saves are still in $DATA/profiles/$name (delete that folder to free the space)"
    [[ -f $DEFAULT_FILE && $(<"$DEFAULT_FILE") == "$name" ]] && rm -f "$DEFAULT_FILE"
    return 0
}

profile_list() {
    local n
    for n in $(printf '%s\n' "${!P_URL[@]}" | sort); do
        printf '%s %-12s %s %s%s(%s)%s\n' "$([[ $n == "$PROFILE" ]] && echo '*' || echo ' ')" \
            "$n" "${P_URL[$n]}" "${P_BRANCH[$n]}" " $c_dim" "${P_ABOUT[$n]}" "$c_off"
    done
    echo "${c_dim}* = the one used now. victory-proton profile NAME sets the default; -p NAME uses one for a run.$c_off"
}

# victory-proton profile proton NAME [PROTON|default]
profile_proton_cmd() {
    local name=${1:-} which=${*:2}
    [[ -n $name ]] || die "usage: victory-proton profile proton NAME [PROTON|default]  (PROTON: a folder, a name from 'victory-proton proton list', or experimental)"
    [[ -n ${P_URL[$name]+x} ]] || die "no profile '$name' (have: $(printf '%s\n' "${!P_URL[@]}" | sort | xargs))"
    if [[ -z $which ]]; then
        local saved=$PROFILE w; PROFILE=$name
        w=$(profile_proton); PROFILE=$saved
        echo "${w:-default (the newest GE-Proton)}"; return
    fi
    mkdir -p "$CONFIG_DIR"; touch "$PROTONS_FILE"
    local tmp; tmp=$(mktemp)
    awk -v n="$name" '$1 != n' "$PROTONS_FILE" >"$tmp"
    if [[ $which == default ]]; then
        mv "$tmp" "$PROTONS_FILE"
        info "profile $name: back to the default Proton (the newest GE-Proton)"; return
    fi
    local dir; dir=$(resolve_proton "$which")
    if [[ -z $dir && ! ( $which == GE-Proton* && $which != */* ) ]]; then
        rm -f "$tmp"; die "no Proton '$which' found (see: victory-proton proton list)"
    fi
    printf '%s %s\n' "$name" "$which" >>"$tmp"
    mv "$tmp" "$PROTONS_FILE"
    info "profile $name now runs with ${dir:-$which (installed on its next run)}, in a wine prefix of its own"
    if [[ -n $dir ]] && ! proton_source "$(proton_tag "$dir" | sed 's/-x86_64.*//')" >/dev/null; then
        warn "no known sources for $(proton_tag "$dir"): it runs with its own wineserver (VP_PROTON_SRC=OWNER/REPO if it is built like GE-Proton)"
    fi
    return 0
}

proton_list() {
    local tag d
    while read -r tag d; do printf '%-40s %s\n' "$tag" "$d"; done < <(list_all | sort -V)
    echo "${c_dim}Set one for a profile with: victory-proton profile proton NAME PROTON (a folder name or version from above, or experimental)$c_off"
}

profile_cmd() {
    case ${1:-} in
        "")        profile_list ;;
        proton)    shift; profile_proton_cmd "$@" ;;
        add)       shift; profile_add "$@" ;;
        remove|rm) shift; profile_remove "$@" ;;
        *)
            [[ -n ${P_URL[$1]+x} ]] || die "no profile '$1' (have: $(printf '%s\n' "${!P_URL[@]}" | sort | xargs))"
            mkdir -p "$CONFIG_DIR"
            printf '%s\n' "$1" >"$DEFAULT_FILE"
            info "default profile: $1 (${P_URL[$1]} ${P_BRANCH[$1]})" ;;
    esac
}

# -p NAME|URL anywhere before `--` picks the profile for this run. A URL is
# added as a profile first, so its build and saves are kept.
PROFILE=${VP_PROFILE:-}
argv=()
while (($#)); do
    case $1 in
        --) argv+=("$@"); break ;;
        -p|--profile) [[ $# -ge 2 ]] || die "a profile name or URL must follow $1"
                      PROFILE=$2; shift 2; continue ;;
        --profile=*)  PROFILE=${1#*=} ;;
        *) argv+=("$1") ;;
    esac
    shift
done
set -- "${argv[@]+"${argv[@]}"}"
if [[ $PROFILE == */* ]]; then ADDED=; profile_add "$PROFILE"; PROFILE=$ADDED; fi
[[ -z $PROFILE && -f $DEFAULT_FILE ]] && PROFILE=$(<"$DEFAULT_FILE")
PROFILE=${PROFILE:-$DEFAULT_PROFILE}
[[ -n ${P_URL[$PROFILE]+x} ]] || die "no profile '$PROFILE' (have: $(printf '%s\n' "${!P_URL[@]}" | sort | xargs))"

UPSTREAM=${VP_UPSTREAM:-${P_URL[$PROFILE]}}
BRANCH=${VP_BRANCH:-${P_BRANCH[$PROFILE]}}
PDATA=$DATA/profiles/$PROFILE        # src/, cache/, data/ (saves), logs/
SRC=${VP_SRC:-$PDATA/src}
# VP_NATIVE=1 (in the environment or among a profile's variables): the fork
# has a native Linux runtime (no wine, no Windows DLL). It is built for Linux
# with plain cargo and loads vkd3d-proton built as native .so libraries
# (VICTORY_VKD3D), SDL3 for the window and pads, and libpulse for sound.
NATIVE=${VP_NATIVE:-}
if [[ -z $NATIVE ]]; then
    NATIVE=0
    [[ " ${P_ENV[$PROFILE]:-} " == *" VP_NATIVE=1 "* ]] && NATIVE=1
fi
if ((NATIVE)); then EXE=$SRC/target/release/victory
else EXE=$SRC/target/$TARGET/release/victory.exe; fi
VKD3D_SRC=$DATA/vkd3d-proton/src     # native vkd3d-proton: source,
VKD3D_DIR=$DATA/vkd3d-proton/install # and where it is installed
# A running game's command line, the wine build or the native one.
PROC_RE='release[/\\]victory(\.exe)? run'

# ---------------------------------------------------------------- GPU
# nvidia, amd or intel: the vendor of the GPU the game most likely runs on (a
# discrete NVIDIA card wins over an AMD or Intel integrated one). VP_GPU sets it.
gpu_vendor() {
    if [[ -n ${VP_GPU:-} && $VP_GPU != auto ]]; then echo "$VP_GPU"; return; fi
    local v vendors=" "
    for v in /sys/class/drm/card[0-9]*/device/vendor; do
        [[ -r $v ]] && vendors+="$(<"$v") "
    done
    case $vendors in
        *" 0x10de "*) echo nvidia ;;
        *" 0x1002 "*) echo amd ;;
        *" 0x8086 "*) echo intel ;;
        *) echo unknown ;;
    esac
}
# AMD (RADV): the meshlet-culling program 0xfc5e66f8f873d3bb page-faults the
# GPU minutes into the world (fxceless/victory-fork#3); skip it.
AMD_ENV="VICTORY_SKIP_PIPELINES=fc5e66f8f873d3bb"

# The profile's variables, and the AMD ones on AMD (unless the profile sets
# the same variable itself).
profile_vars() {
    local all kv
    all=$(xargs <<<"${P_ENV[$PROFILE]:-}")
    if [[ $(gpu_vendor) == amd ]]; then
        for kv in $AMD_ENV; do [[ " $all" == *" ${kv%%=*}="* ]] || all+=" $kv"; done
    fi
    printf '%s' "${all# }"
}
# Exports them, except those set already (yours win).
export_profile_vars() {
    local kv name
    for kv in $(profile_vars); do
        name=${kv%%=*}
        if [[ -z ${!name+x} ]]; then export "${kv?}"; fi
    done
}

# ---------------------------------------------------------------- game
# The game folder is an Xbox Series (GDK) package dumped from a console you
# own: MicrosoftGame.config names the executable.
game_dir() {
    if [[ -n ${VP_GAME_DIR:-} ]]; then printf '%s' "$VP_GAME_DIR"; return; fi
    [[ -f $GAME_FILE ]] && cat "$GAME_FILE"
    return 0
}

# The executable named in MicrosoftGame.config (the Series one if there are
# several), else the only .exe in the folder.
game_exe() {
    local dir=$1 cfg exe
    if [[ -n ${VP_GAME_EXE:-} ]]; then printf '%s' "$VP_GAME_EXE"; return; fi
    cfg=$(find "$dir/" -maxdepth 1 -iname microsoftgame.config -print -quit)
    if [[ -n $cfg ]]; then
        exe=$(grep -aoi '<Executable [^>]*>' "$cfg" | grep -ai 'Scarlett' | head -n1)
        [[ -n $exe ]] || exe=$(grep -aoi '<Executable [^>]*>' "$cfg" | head -n1)
        exe=$(sed -n 's/.*[Nn]ame="\([^"]*\)".*/\1/p' <<<"$exe")
        [[ -n $exe && -f $dir/$exe ]] && { printf '%s' "$exe"; return; }
    fi
    local exes=()
    mapfile -t exes < <(find "$dir/" -maxdepth 1 -iname '*.exe' -printf '%f\n')
    ((${#exes[@]} == 1)) && { printf '%s' "${exes[0]}"; return; }
    return 1
}

check_game_dir() {
    local dir=$1
    [[ -d $dir ]] || die "not a folder: $dir"
    game_exe "$dir" >/dev/null || die "$dir has no MicrosoftGame.config naming an .exe (is it the game's root folder?). Set VP_GAME_EXE if it is"
}

pick_dir() {
    local d=
    if [[ -n ${WAYLAND_DISPLAY:-${DISPLAY:-}} ]]; then
        if command -v zenity >/dev/null; then
            d=$(zenity --file-selection --directory --title="Choose the game folder (the one with MicrosoftGame.config)" 2>/dev/null) || true
        elif command -v kdialog >/dev/null; then
            d=$(kdialog --getexistingdirectory "$HOME" --title "Choose the game folder" 2>/dev/null) || true
        fi
    fi
    if [[ -z $d && -t 0 ]]; then
        read -r -e -p "Game folder (the one with MicrosoftGame.config): " d
        d=${d/#\~/$HOME}
    fi
    [[ -n $d ]] || die "no folder chosen"
    printf '%s' "$d"
}

game_set() {
    local dir; dir=$(realpath -m "$1")
    check_game_dir "$dir"
    mkdir -p "$CONFIG_DIR"
    printf '%s\n' "$dir" >"$GAME_FILE"
    info "game: $dir ($(game_exe "$dir")). It is mounted read-only whenever the game runs."
}

# Asks for the game folder and saves it.
pick_game() { local d; d=$(pick_dir) || exit 1; game_set "$d"; }

game_cmd() {
    case ${1:-} in
        pick) pick_game ;;
        "")
            local dir; dir=$(game_dir)
            if [[ -z $dir ]]; then pick_game; return; fi
            echo "$dir  ($(game_exe "$dir" || echo 'no executable found'))" ;;
        *) game_set "$1" ;;
    esac
}

# The game folder for a run; asks once if none is set.
require_game() {
    GAME_DIR=$(game_dir)
    if [[ -z $GAME_DIR ]]; then
        info "no game folder set yet"
        pick_game
        GAME_DIR=$(game_dir)
    fi
    check_game_dir "$GAME_DIR"
    GAME_DIR=$(realpath "$GAME_DIR")   # bubblewrap cannot mount over a symlink
    GAME_EXE=$(game_exe "$GAME_DIR")
}

# ---------------------------------------------------------------- proton
# Which Proton runs the game, first that applies:
#   VP_PROTON (environment or config file): for every profile;
#   the one set for the profile (`victory-proton profile proton NAME PROTON`,
#   or VP_PROTON=... among the variables of a profile you added);
#   the newest GE-Proton installed.
# PROTON is a folder, a folder name as Steam lists it ("Proton - Experimental",
# "proton-cachyos-..."), a version ("GE-Proton10-34"), or "experimental".
# A profile with a Proton of its own gets a wine prefix of its own too.
profile_proton() {
    local name which
    if [[ -f $PROTONS_FILE ]]; then
        while read -r name which; do
            [[ $name == "$PROFILE" && -n $which ]] && { printf '%s' "$which"; return 0; }
        done <"$PROTONS_FILE"
    fi
    local kv
    for kv in ${P_ENV[$PROFILE]:-}; do
        [[ $kv == VP_PROTON=?* ]] && { printf '%s' "${kv#VP_PROTON=}"; return 0; }
    done
    return 0
}
PROTON_WHICH=${VP_PROTON:-$(profile_proton)}
PROTON_DIR=
# The prefix: shared by every profile on the default Proton; one per Proton
# chosen for a profile (prefixes do not like going back and forth between
# wine versions).
if [[ -n $PROTON_WHICH && -z ${VP_PROTON:-} ]]; then
    PREFIX_ROOT=$DATA/prefixes/$(printf '%s' "${PROTON_WHICH##*/}" | tr -c 'A-Za-z0-9._-' '_')
else
    PREFIX_ROOT=$DATA/prefix
fi
proton_dirs() {
    printf '%s\n' "$HOME/.local/share/Steam/compatibilitytools.d" "$HOME/.steam/root/compatibilitytools.d" \
        "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/compatibilitytools.d" \
        /usr/share/steam/compatibilitytools.d "$DATA/proton"
}
# Where `proton` installs GE-Proton: Steam's folder if Steam is there.
install_dir() {
    if [[ -d $HOME/.local/share/Steam ]]; then echo "$HOME/.local/share/Steam/compatibilitytools.d"
    else echo "$DATA/proton"; fi
}
proton_tag() { awk '{print $2}' "${1:-$PROTON_DIR}/version" 2>/dev/null; }

# Steam's own Protons (Proton - Experimental, Proton 9.0, ...).
steam_common_dirs() {
    printf '%s\n' "$HOME/.local/share/Steam/steamapps/common" "$HOME/.steam/root/steamapps/common" \
        "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/steamapps/common"
}
# Every Proton found, "TAG DIR", once each (by real path).
list_all() {
    local base d tag seen=" "
    while read -r base; do
        [[ -d $base ]] || continue
        for d in "$base"/*/; do
            d=${d%/}
            [[ -x $d/proton && -f $d/version ]] || continue
            local real; real=$(realpath "$d")
            [[ $seen == *" $real "* ]] && continue
            seen+="$real "
            tag=$(proton_tag "$d")
            printf '%s %s\n' "${tag:-?}" "$d"
        done
    done < <(proton_dirs; steam_common_dirs)
}
# Every GE-Proton found, "TAG DIR".
list_ge() { list_all | awk '$1 ~ /^GE-Proton/'; }

# The folder of PROTON (see above), or nothing.
resolve_proton() {
    local want=$1 tag d name lc
    if [[ $want == */* || $want == "~"* ]]; then
        want=${want/#\~/$HOME}
        [[ -x $want/proton ]] && printf '%s' "$(realpath "$want")"
        return 0
    fi
    [[ ${want,,} == experimental ]] && want="Proton - Experimental"
    lc=${want,,}
    while read -r tag d; do
        name=$(basename "$d")
        name=${name,,}
        if [[ $name == "$lc" || $name == "$lc-x86_64" || ${tag,,} == "$lc" ]]; then
            printf '%s' "$d"; return 0
        fi
    done < <(list_all)
    return 0
}

ver_ge() { [[ $(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1) == "$2" ]]; }   # $1 >= $2

find_proton() {
    [[ -n $PROTON_DIR ]] && return
    if [[ -n $PROTON_WHICH ]]; then
        local from="the Proton set for profile $PROFILE"
        [[ -n ${VP_PROTON:-} ]] && from="VP_PROTON"
        PROTON_DIR=$(resolve_proton "$PROTON_WHICH")
        if [[ -z $PROTON_DIR && $PROTON_WHICH == GE-Proton* && $PROTON_WHICH != */* ]]; then
            info "$from is $PROTON_WHICH, which is not installed; installing it"
            install_proton "$PROTON_WHICH" >&2
            PROTON_DIR=$(resolve_proton "$PROTON_WHICH")
        fi
        [[ -n $PROTON_DIR ]] || die "$from is '$PROTON_WHICH', and no such Proton is installed (see: victory-proton proton list)"
        [[ $(proton_tag) != GE-Proton* ]] || ver_ge "$(proton_tag)" "$GE_MIN" \
            || warn "$(proton_tag) is older than $GE_MIN, which the first 3D scenes need (exit code 3)"
        return
    fi
    local best
    best=$(list_ge | sort -V -k1,1 | tail -n1)
    [[ -n $best ]] || die "no GE-Proton found; install the newest with: victory-proton proton"
    PROTON_DIR=${best#* }
    ver_ge "$(proton_tag)" "$GE_MIN" || warn "$(proton_tag) is older than $GE_MIN, which the first 3D scenes need (exit code 3): victory-proton proton"
}

latest_ge() {
    curl -fsS --max-time 10 "https://api.github.com/repos/$GE_REPO/releases/latest" \
        | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n1 || true
}

check_proton() {
    [[ -n $PROTON_WHICH ]] && return
    local latest; latest=$(latest_ge)
    [[ -n $latest ]] || return 0
    [[ $'\n'$(list_ge) == *$'\n'"$latest "* ]] || warn "a newer GE-Proton is out ($latest; you use $(proton_tag)): victory-proton proton"
}

install_proton() {
    need curl
    local tag=${1:-$(latest_ge)}
    [[ -n $tag ]] || die "cannot tell which GE-Proton is the newest (no network?)"
    if [[ $'\n'$(list_ge) == *$'\n'"$tag "* ]]; then info "$tag is installed already"; return; fi
    local tmp name=$tag-x86_64 base=https://github.com/$GE_REPO/releases/download/$tag dest
    tmp=$(mktemp -d)
    info "downloading $tag (~600 MB)"
    if ! curl -fL --progress-bar -o "$tmp/$name.tar.gz" "$base/$name.tar.gz"; then
        name=$tag   # older releases have no -x86_64 suffix
        curl -fL --progress-bar -o "$tmp/$name.tar.gz" "$base/$name.tar.gz" || die "cannot download $tag"
    fi
    curl -fsSL -o "$tmp/$name.sha512sum" "$base/$name.sha512sum" || die "cannot download the checksum of $tag"
    (cd "$tmp" && sha512sum -c --quiet "$name.sha512sum") || die "the checksum of $tag does not match"
    dest=$(install_dir)
    mkdir -p "$dest"
    tar -xzf "$tmp/$name.tar.gz" -C "$dest"
    rm -rf "$tmp"
    info "$tag installed in $dest"
}

# ---------------------------------------------------------------- wineserver
# wineserver keeps each process's mapped views in a list and walks it on
# every map_view and unmap_view. A title that aliases GPU memory one 64 KiB
# page at a time has 20,000+ views, so each call takes 0.5-1 ms, the server
# sits at most of a core and VIctory's remap lock starves texture uploads for
# seconds a frame. wine/wineserver-view-tree.patch indexes the views in a
# red-black tree as well: about 10 us a call. The server must come from
# exactly the tree of the Proton in use (same protocol), so it is built from
# that GE-Proton release's own sources.
#
# Wine always execs the wineserver in its own bin/ folder (it finds it from
# where ntdll.so really is, so a symlink does not do). So the game runs with a
# copy of the GE-Proton release, hard links where the filesystem allows,
# whose files/bin/wineserver is the patched one: $DATA/proton-vt/<tag>-vt.
wineserver_path() { printf '%s/wineserver/%s-viewtree' "$DATA" "$(proton_tag)"; }

# The wineserver to use: VP_WINESERVER, else the patched one if built, else
# none (Proton's own). VP_WINESERVER=0 forces Proton's own.
wanted_wineserver() {
    if [[ ${VP_WINESERVER:-} == 0 ]]; then return 0; fi
    if [[ -n ${VP_WINESERVER:-} ]]; then printf '%s' "$VP_WINESERVER"; return 0; fi
    [[ -x $(wineserver_path) ]] && wineserver_path
    return 0
}

# Points PROTON_DIR at the copy of the current GE-Proton that has wineserver
# $1 in it, making (or refreshing) the copy first.
use_wineserver() {
    local ws=$1 tag dst tmp
    [[ -x $ws ]] || die "wineserver $ws is not executable"
    tag=$(proton_tag)
    dst=$DATA/proton-vt/$tag-vt
    if ! cmp -s "$ws" "$dst/files/bin/wineserver"; then
        info "making $dst: $tag with the patched wineserver (hard links, next to no space)"
        tmp=$dst.tmp
        rm -rf "$tmp"
        mkdir -p "$DATA/proton-vt"
        cp -al "$PROTON_DIR" "$tmp" 2>/dev/null || { rm -rf "$tmp"; cp -a --reflink=auto "$PROTON_DIR" "$tmp"; } \
            || die "cannot copy $PROTON_DIR to $tmp"
        rm -f "$tmp/files/bin/wineserver"   # a hard link: never write through it
        cp "$ws" "$tmp/files/bin/wineserver"
        rm -rf "$dst"
        mv "$tmp" "$dst"
    fi
    PROTON_DIR=$dst
}

# Builds the patched wineserver now when it is missing (once per GE-Proton
# release, 10-20 min). Never fatal: the game runs with the stock one if the
# build fails.
ensure_wineserver() {
    [[ ${VP_WINESERVER:-} == 0 || -n ${VP_WINESERVER:-} ]] && return 0
    [[ -x $(wineserver_path) ]] && return 0
    if ! proton_source "$(proton_tag | sed 's/-x86_64.*//')" >/dev/null; then
        warn "no known sources for $(proton_tag), so no patched wineserver: it runs with its own (busy scenes about half as fast; VP_PROTON_SRC=OWNER/REPO if it is built like GE-Proton)"
        return 0
    fi
    info "building the patched wineserver for $(proton_tag), once per GE-Proton release (10-20 min; VP_WINESERVER=0 skips it)"
    if ! VP_PROTON=$PROTON_DIR "$REPO_DIR/victory-proton" wineserver; then
        warn "could not build the patched wineserver; running with Proton's own (busy scenes will be about half as fast)"
    fi
    return 0
}

# The view-tree patch: next to this script (a clone of this repository), else
# in the profile's own tree (forks that ship it in linux/wineserver/), else
# downloaded from this repository (when only the script was copied).
find_ws_patch() {
    local f
    for f in "$REPO_DIR/wine/wineserver-view-tree.patch" "$SRC/linux/wineserver/wineserver-view-tree.patch"; do
        [[ -s $f ]] && { WS_PATCH=$f; return; }
    done
    WS_PATCH=$DATA/wineserver/wineserver-view-tree.patch
    need curl
    info "the view-tree patch is not next to this script; downloading it"
    mkdir -p "$DATA/wineserver"
    curl -fsSL --max-time 30 -o "$WS_PATCH.tmp" "$WS_PATCH_URL" && grep -q '^+++ .*server/mapping.c' "$WS_PATCH.tmp" \
        || { rm -f "$WS_PATCH.tmp"; die "cannot download the view-tree patch ($WS_PATCH_URL); clone the whole repository instead of copying the script alone"; }
    mv "$WS_PATCH.tmp" "$WS_PATCH"
}

WS_DEPS=(git patch autoreconf bison flex make gcc perl)

# Where a Proton's sources are, from the tag in its version file:
# "REPO PREP". Each release is a git tag there with wine as a submodule.
# PREP is how that Proton patches wine before building it: "ge" (the `pushd
# wine` section of patches/protonprep-valve-staging.sh, GE and UMU),
# "dir" (patches/wine/*.patch if there, CachyOS), or "none" (Valve: the
# patches are commits in its wine). VP_PROTON_SRC=OWNER/REPO [PREP] names it
# for another Proton built the same way.
proton_source() {
    local tag=$1
    if [[ -n ${VP_PROTON_SRC:-} ]]; then
        local repo prep; read -r repo prep <<<"$VP_PROTON_SRC"
        printf '%s %s' "$repo" "${prep:-ge}"; return
    fi
    case $tag in
        GE-Proton*)              echo "$GE_REPO ge" ;;
        UMU-Proton*)             echo "Open-Wine-Components/umu-proton ge" ;;
        experimental-*|proton-*) echo "ValveSoftware/Proton none" ;;
        cachyos-*)               echo "CachyOS/proton-cachyos dir" ;;
        *) return 1 ;;
    esac
}

# Starts the Proton copy with wineserver $1 on a throwaway prefix: wine
# refuses a server whose protocol is not its own ("version mismatch").
check_wineserver() {
    local ws=$1 tmp out rc=0
    use_wineserver "$ws"
    tmp=$(mktemp -d "$DATA/wineserver/check.XXXXXX")
    info "checking it against $(proton_tag)'s wine (a throwaway prefix, up to a minute)"
    out=$(env -u DISPLAY -u WAYLAND_DISPLAY WINEPREFIX="$tmp/pfx" WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml=" \
        timeout 180 "$PROTON_DIR/files/bin/wine" cmd /c exit 2>&1) || rc=$?
    WINEPREFIX=$tmp/pfx "$PROTON_DIR/files/bin/wineserver" -k 2>/dev/null || true
    rm -rf "$tmp"
    if grep -qi 'version mismatch' <<<"$out"; then return 1; fi
    ((rc == 0)) || warn "the check did not finish cleanly (code $rc), but wine took the server"
    return 0
}

build_wineserver() {
    find_proton
    need "${WS_DEPS[@]}"
    local tag; tag=$(proton_tag)
    local src_tag=${tag%-x86_64*}   # Valve's version files add the architecture
    local repo prep
    read -r repo prep <<<"$(proton_source "$src_tag")" \
        || die "no known sources for ${tag:-this Proton} ($PROTON_DIR). GE-Proton, Steam's Protons, Proton-CachyOS and UMU-Proton are supported; for another one built the same way set VP_PROTON_SRC=OWNER/REPO"
    find_ws_patch
    info "patch: $WS_PATCH"
    local root=$DATA/wineserver/build-$tag out; out=$(wineserver_path)
    local top=$root/proton
    info "building wineserver with the view-tree patch for $tag from github.com/$repo (in $root, ~1 GB)"
    mkdir -p "$root"
    [[ -d $root/ge/.git && ! -d $top ]] && mv "$root/ge" "$top"   # older builds' folder name
    if [[ ! -d $top/.git || $(git -C "$top" remote get-url origin 2>/dev/null) != "https://github.com/$repo" ]]; then
        rm -rf "$top"
        git init -q "$top"
        git -C "$top" remote add origin "https://github.com/$repo"
    fi
    git -C "$top" fetch -q --depth 1 origin tag "$src_tag" || die "github.com/$repo has no tag $src_tag"
    git -C "$top" checkout -q -f "$src_tag"
    local m url sha
    for m in wine wine-staging; do
        sha=$(git -C "$top" ls-tree HEAD "$m" | awk '$2 == "commit" {print $3}')
        if [[ -z $sha ]]; then
            [[ $m == wine ]] && die "$repo $src_tag has no wine submodule"
            continue
        fi
        url=$(git -C "$top" config -f .gitmodules "submodule.$m.url")
        [[ $url == ../* ]] && url=https://github.com/${repo%%/*}/${url#../}   # relative to the repository
        if [[ $(git -C "$top/$m" rev-parse HEAD 2>/dev/null) != "$sha" ]]; then
            info "fetching $m ($sha)"
            rm -rf "${top:?}/$m"
            git init -q "$top/$m"
            git -C "$top/$m" remote add origin "$url"
            git -C "$top/$m" fetch -q --depth 1 origin "$sha" || die "cannot fetch $m $sha from $url"
            git -C "$top/$m" checkout -q FETCH_HEAD
        else
            git -C "$top/$m" reset -q --hard && git -C "$top/$m" clean -qfdx   # undo the last build's patching
        fi
    done
    case $prep in
        ge)
            # The helpers and the `pushd wine` section of its prep script.
            local script=$top/patches/protonprep-valve-staging.sh
            [[ -f $script ]] || die "$script not found; $repo may have changed its layout"
            {
                sed -n '/^apply_patch()/,/^}/p;/^apply_all_in_dir()/,/^}/p' "$script"
                awk '/^[[:space:]]*pushd wine$/ {on=1} on {print} on && /^[[:space:]]*popd/ {exit}' "$script"
            } >"$root/prep-wine.sh"
            info "applying $repo's patches to wine (log: $root/prep.log)"
            (cd "$top" && bash "$root/prep-wine.sh") >"$root/prep.log" 2>&1 || die "$repo's patches failed; see $root/prep.log"
            ;;
        dir)
            local f
            for f in $(find "$top/patches/wine" -name '*.patch' 2>/dev/null | sort); do
                patch -d "$top/wine" -Np1 -s -i "$f" >>"$root/prep.log" 2>&1 || die "$f does not apply; see $root/prep.log"
            done
            ;;
    esac
    (cd "$top/wine" && patch -p1 -s <"$WS_PATCH") || die "the view-tree patch does not apply to $tag; please open an issue"
    info "configuring (wineserver only)"
    (
        cd "$top/wine"
        # The server protocol's generated headers (Valve's wine does not keep
        # them up to date in git); the same output when they are.
        perl tools/make_requests >/dev/null 2>&1 || true
        tools/make_specfiles >/dev/null 2>&1 || true
        autoreconf -fi >/dev/null 2>&1
        # Vulkan's generated sources are not needed for the server; empty
        # stand-ins let configure write the Makefile without vk.xml.
        local f
        for f in include/wine/vulkan.h include/wine/vulkan_driver.h dlls/winevulkan/{loader_thunks.c,loader_thunks.h,vulkan_thunks.c,vulkan_thunks.h,winevulkan.json,winevulkan.spec}; do
            [[ -e $f ]] || : >"$f"
        done
    )
    rm -rf "$root/build"
    mkdir -p "$root/build"
    (cd "$root/build" && "$top/wine/configure" --enable-archs=x86_64 --disable-tests \
        --without-x --without-wayland --without-vulkan --without-freetype --without-gstreamer \
        --without-pulse --without-alsa --without-oss --without-cups --without-sane --without-gphoto \
        --without-krb5 --without-netapi --without-pcap --without-usb --without-v4l2 --without-opencl \
        --without-sdl --without-capi --without-dbus --without-gnutls --without-opengl --without-osmesa \
        --without-udev --without-unwind --without-ffmpeg >configure.log 2>&1) \
        || die "configure failed; see $root/build/configure.log"
    (cd "$root/build" && make -j"$(nproc)" server/wineserver >make.log 2>&1) \
        || die "the build failed; see $root/build/make.log"
    local new=$root/build/server/wineserver
    if ! check_wineserver "$new"; then
        rm -rf "$DATA/proton-vt/$tag-vt"
        die "the built wineserver does not match $tag's wine (version mismatch); not used. Please open an issue"
    fi
    install -Dm755 "$new" "$out"
    info "done: $out (used automatically with $tag; VP_WINESERVER=0 turns it off)"
    info "the build tree $root (~1 GB) is not needed any more; delete it to free the space"
}

# ---------------------------------------------------------------- update
update() {
    need git
    if [[ ! -d $SRC/.git ]]; then
        info "cloning $UPSTREAM ($BRANCH) into $SRC"
        mkdir -p "$(dirname "$SRC")"
        # Borrow objects from other profiles' checkouts when the fork shares
        # their history (much less to download); --dissociate keeps it apart.
        local ref=() d
        for d in "$DATA"/profiles/*/src; do
            [[ $d != "$SRC" && -d $d/.git ]] && ref+=(--reference-if-able "$d")
        done
        git clone ${ref[@]+"${ref[@]}"} ${ref[@]+--dissociate} --branch "$BRANCH" "$UPSTREAM" "$SRC"
        git -C "$SRC" update-ref "$SYNCED" HEAD
        return
    fi
    info "profile $PROFILE: looking for updates ($UPSTREAM, $BRANCH)"
    if ! git -C "$SRC" fetch --quiet "$UPSTREAM" "$BRANCH"; then
        warn "cannot reach the repository; going on with the local copy ($(git -C "$SRC" log -1 --format='%h %cd' --date=short))"
        return
    fi
    local here there synced
    here=$(git -C "$SRC" rev-parse HEAD)
    there=$(git -C "$SRC" rev-parse FETCH_HEAD)
    synced=$(git -C "$SRC" rev-parse -q --verify "$SYNCED" || true)
    if [[ $here == "$there" ]]; then
        git -C "$SRC" update-ref "$SYNCED" HEAD
        info "up to date ($(git -C "$SRC" log -1 --format='%h %s' | cut -c1-70))"
        return
    fi
    if git -C "$SRC" merge-base --is-ancestor "$there" "$here" && [[ $here != "$synced" ]]; then
        info "the local copy is ahead of the repository; leaving it as it is"
        return
    fi
    info "new in the repository:"
    # --max-count, not `| head`: under pipefail head's early exit kills git.
    git -C "$SRC" --no-pager log --oneline --no-decorate --max-count=20 "$here..$there" | sed 's/^/     /' >&2
    local total; total=$(git -C "$SRC" rev-list --count "$here..$there")
    ((total > 20)) && printf '     ... and %d more\n' $((total - 20)) >&2
    if ! git -C "$SRC" diff --quiet || ! git -C "$SRC" diff --cached --quiet; then
        warn "$SRC has uncommitted changes; not updating (commit or stash them)"
        return
    fi
    if git -C "$SRC" merge-base --is-ancestor "$here" "$there"; then
        git -C "$SRC" merge --ff-only --quiet "$there"
    elif [[ $here == "$synced" ]]; then
        # Forks that keep their changes in one rebased commit rewrite history.
        # HEAD is exactly what this script last checked out (no commits of
        # yours on top), so following it loses nothing.
        info "the repository rewrote its history; following it"
        git -C "$SRC" reset --hard --quiet "$there"
    else
        warn "you have commits of your own in $SRC and the repository diverged; going on with the local copy"
        return
    fi
    git -C "$SRC" update-ref "$SYNCED" HEAD
    info "updated to $(git -C "$SRC" log -1 --format='%h %cd' --date=short)"
}

# ---------------------------------------------------------------- build
build() {
    command -v rustup >/dev/null || die "rustup is missing; run: victory-proton setup"
    if ((NATIVE)); then
        [[ -d $SRC ]] || update
        info "building VIctory for Linux (native runtime, cargo build)"
        (cd "$SRC" && cargo build --release -p victory "$@") \
            || die "the build failed (see cargo's output above)"
        [[ -f $EXE ]] || die "$EXE is not there after the build"
        return
    fi
    command -v cargo-xwin >/dev/null || die "cargo-xwin is missing; run: victory-proton setup"
    [[ -d $SRC ]] || update
    info "building VIctory for Windows (cargo xwin, $TARGET)"
    # The repository's rust-toolchain.toml pins the toolchain; rustup fetches it.
    (cd "$SRC" && cargo xwin build --release -p victory --target "$TARGET" "$@") \
        || die "the build failed (see cargo's output above)"
    [[ -f $EXE ]] || die "$EXE is not there after the build"
}

# ---------------------------------------------------------------- vkd3d-proton
# The native runtime needs vkd3d-proton as Linux libraries
# (libvkd3d-proton-d3d12{,core}.so). Proton ships only its Windows DLLs, so
# it is built once from source. VICTORY_VKD3D set by you wins.
vkd3d_lib() {
    local f
    f=$(find "$VKD3D_DIR" -name 'libvkd3d-proton-d3d12.so' -print -quit 2>/dev/null || true)
    [[ -n $f ]] && dirname "$f"
    return 0
}
build_vkd3d() {
    need git ninja glslangValidator widl
    local meson; meson=$(command -v meson || true)
    if [[ -z $meson ]]; then
        need python3
        meson=$DATA/vkd3d-proton/meson/bin/meson
        if [[ ! -x $meson ]]; then
            info "installing meson into $DATA/vkd3d-proton/meson (the system is left alone)"
            python3 -m venv "$DATA/vkd3d-proton/meson" && "$DATA/vkd3d-proton/meson/bin/pip" install -q meson \
                || die "cannot install meson"
        fi
    fi
    if [[ -d $VKD3D_SRC/.git ]]; then
        info "updating vkd3d-proton in $VKD3D_SRC"
        { git -C "$VKD3D_SRC" pull -q --ff-only && git -C "$VKD3D_SRC" submodule update -q --init --recursive; } \
            || warn "cannot update vkd3d-proton; building what is there"
    else
        info "cloning vkd3d-proton into $VKD3D_SRC"
        mkdir -p "$(dirname "$VKD3D_SRC")"
        git clone -q --recurse-submodules https://github.com/HansKristian-Work/vkd3d-proton "$VKD3D_SRC"
    fi
    info "building native vkd3d-proton ($(git -C "$VKD3D_SRC" log -1 --format='%h %cd' --date=short))"
    local b=$VKD3D_SRC/build-native
    [[ -d $b ]] || "$meson" setup "$b" "$VKD3D_SRC" --buildtype=release --prefix="$VKD3D_DIR" >/dev/null \
        || die "meson setup of vkd3d-proton failed"
    # A generated header sometimes races; a second run finishes it.
    ninja -C "$b" install >/dev/null 2>&1 || ninja -C "$b" install || die "the vkd3d-proton build failed"
    [[ -n $(vkd3d_lib) ]] || die "no libvkd3d-proton-d3d12.so in $VKD3D_DIR after the build"
    info "done: $(vkd3d_lib) (used by native profiles)"
}
vkd3d_ready() { [[ -n ${VICTORY_VKD3D:-} || -n $(vkd3d_lib) ]] || build_vkd3d; }

# ---------------------------------------------------------------- prefix
steam_client() {
    local d
    for d in "$HOME/.steam/steam" "$HOME/.local/share/Steam" "$HOME/.var/app/com.valvesoftware.Steam/data/Steam"; do
        [[ -d $d ]] && { echo "$d"; return; }
    done
    mkdir -p "$DATA/steam"; echo "$DATA/steam"
}

prefix() {
    ((NATIVE)) && return
    find_proton
    local stamp=$PREFIX_ROOT/.victory-proton
    if [[ -d $PREFIX_ROOT/pfx && -f $stamp && $(<"$stamp") == "$(proton_tag)" ]]; then return; fi
    info "setting up the wine prefix with $(proton_tag) (installs DXVK and vkd3d-proton)"
    mkdir -p "$PREFIX_ROOT"
    STEAM_COMPAT_DATA_PATH=$PREFIX_ROOT STEAM_COMPAT_CLIENT_INSTALL_PATH=$(steam_client) WINEDEBUG=-all \
        "$PROTON_DIR/proton" run "$EXE" config >/dev/null 2>&1 || true
    [[ -f $PREFIX_ROOT/pfx/drive_c/windows/system32/d3d12core.dll ]] \
        || die "Proton did not set up the prefix in $PREFIX_ROOT"
    proton_tag >"$stamp"
}

# VIctory compiles a few helper shaders from HLSL at run time with
# D3DCompile. Wine's builtin d3dcompiler_47 lacks parts of HLSL ("Method
# 'InterlockedMax' is not defined on type 'RWByteAddressBuffer'"), so every
# ExecuteIndirect is dropped and the GPU-driven world draws nothing; only 2D
# shows. Microsoft's DLL (winetricks d3dcompiler_47) compiles them. Checked
# on every launch because Proton may put its builtin back when it updates.
d3dcompiler_native() {
    local dll=$PREFIX_ROOT/pfx/drive_c/windows/system32/d3dcompiler_47.dll
    [[ -f $dll ]] && ! grep -aq 'Wine builtin DLL' "$dll"
}
d3dcompiler() {
    ((NATIVE)) && return
    d3dcompiler_native && return
    need winetricks
    info "installing Microsoft's d3dcompiler_47 in the prefix (wine's cannot compile VIctory's shaders)"
    WINEPREFIX=$PREFIX_ROOT/pfx WINE=$PROTON_DIR/files/bin/wine WINESERVER=$PROTON_DIR/files/bin/wineserver \
        WINEDEBUG=-all winetricks -q --force d3dcompiler_47 >/dev/null 2>&1 || true
    d3dcompiler_native || warn "could not install d3dcompiler_47; the 3D world will be black"
    return 0
}

# ---------------------------------------------------------------- huge pages
# Profiles whose tree has linux/thp/victory-thp-collapse.c (kroeeee's): its
# renderer port 1 opens a ~185 MB heap of the title as a GPU userptr, and
# amdgpu walks it page by page on every submission. As 2 MiB transparent huge
# pages that walk is 512 times shorter (~9 -> ~18 fps). A small helper
# collapses those ranges, named in the log, from outside the process every
# 15 s (process_madvise MADV_COLLAPSE). It needs CAP_SYS_NICE, given once with
# sudo by `victory-proton thp` (setup does it). VICTORY_THP=0 turns it off.
thp_src() { [[ -f $SRC/linux/thp/victory-thp-collapse.c ]] && printf '%s' "$SRC/linux/thp/victory-thp-collapse.c"; }
THP_HELPER=$DATA/thp/victory-thp-collapse
thp_has_cap() { command -v getcap >/dev/null && getcap "$THP_HELPER" 2>/dev/null | grep -q cap_sys_nice; }
# Builds the helper when its source changed (a rebuild drops the capability).
thp_build() {
    local src; src=$(thp_src) || return 1
    command -v cc >/dev/null || return 1
    local tmp; tmp=$(mktemp)
    cc -O2 -o "$tmp" "$src" 2>/dev/null || { rm -f "$tmp"; return 1; }
    if cmp -s "$tmp" "$THP_HELPER"; then rm -f "$tmp"; return 0; fi
    mkdir -p "$(dirname "$THP_HELPER")"
    mv "$tmp" "$THP_HELPER"
    chmod 755 "$THP_HELPER"
}
thp_ready() { [[ ${VICTORY_THP:-1} != 0 ]] && ((!NATIVE)) && [[ -n $(thp_src) ]] && thp_has_cap; }
thp_setup() {
    [[ -n $(thp_src) ]] || die "profile $PROFILE has no huge-page helper (linux/thp/ in its tree; run or update it first)"
    need cc setcap getcap
    thp_build || die "cannot build $(thp_src)"
    if thp_has_cap; then info "huge pages: ready ($THP_HELPER has CAP_SYS_NICE)"; return; fi
    info "giving $THP_HELPER the one capability it needs (CAP_SYS_NICE, not root); sudo asks for your password"
    sudo setcap cap_sys_nice+ep "$THP_HELPER" || die "setcap failed"
    thp_has_cap || die "$THP_HELPER still has no CAP_SYS_NICE (is $DATA on a nosuid filesystem?)"
    info "huge pages: ready"
}
thp_hint() {
    [[ ${VICTORY_THP:-1} == 0 || -z $(thp_src) ]] && return 0
    thp_build || true
    thp_has_cap || warn "huge pages are off, about half the frame rate in the world: run once 'victory-proton thp' (asks for sudo)"
    return 0
}
# Every 15 s: the game's process (the matching one with the most threads),
# the ranges the log names, the helper on them. Results in <log>.thp.
thp_watch() {
    trap - ERR
    set +eu +o pipefail
    local log=$1 out=${1%.log}.thp pid ranges r last= p
    while kill -0 $$ 2>/dev/null; do
        sleep 15
        pid=$(for p in $(pgrep -f "$PROC_RE"); do echo "$(ls /proc/"$p"/task 2>/dev/null | wc -l) $p"; done \
            | sort -rn | awk 'NR==1{print $2}')
        [[ -n $pid ]] || continue
        # (the log may carry ANSI colours between a field's name and its value)
        ranges=$(sed 's/\x1b\[[0-9;]*m//g' "$log" 2>/dev/null \
            | grep -aoE "32-bit heap are private memory.*at=0x[0-9a-f]+ len=[0-9]+" \
            | sed -E 's/.*at=0x([0-9a-f]+) len=([0-9]+)/\1 \2/' | sort -u \
            | while read -r a l; do printf '%x %x ' $((16#$a)) $((16#$a + l)); done)
        [[ -n $ranges ]] || continue
        # shellcheck disable=SC2086
        r=$("$THP_HELPER" "$pid" $ranges 2>&1)
        if [[ $r != "$last" ]]; then echo "$(date +%T) $r" >>"$out"; last=$r; fi
    done
}

gpu_check() {
    local want=${P_GPU[$PROFILE]:-} have
    [[ -n $want ]] || return 0
    have=$(gpu_vendor)
    [[ $have == "$want" ]] || warn "profile $PROFILE is made and tested for $want GPUs (you have: $have); if it does not work, try another: victory-proton profile"
    return 0
}

# ---------------------------------------------------------------- run
running() { pgrep -f "$PROC_RE" >/dev/null; }

# bubblewrap needs unprivileged user namespaces; Ubuntu 23.10+ restricts them
# with AppArmor unless bwrap has a profile.
sandbox_ok() { [[ ${VP_SANDBOX:-1} != 0 ]] && bwrap --dev-bind / / -- true 2>/dev/null; }

# Runs victory.exe with Proton's wine inside a mount namespace in which the
# game folder is read-only: nothing VIctory or the title does can change it.
launch() {
    local label=$1; shift
    running && die "VIctory is running already; close it first (victory-proton kill)"
    ((NATIVE)) && { launch_native "$label" "$@"; return; }
    find_proton
    require_game
    mkdir -p "$PDATA/cache" "$PDATA/data" "$PDATA/logs"

    # The profile's variables first (yours win over them), then the defaults
    # for what neither set.
    local penv; penv=$(profile_vars)
    export_profile_vars
    export WINEPREFIX=$PREFIX_ROOT/pfx
    export WINEDLLOVERRIDES=${WINEDLLOVERRIDES:-"d3d12,d3d12core,dxgi,d3d11,d3d10core,d3d9,d3dcompiler_47=n,b"}
    export WINEDEBUG=${WINEDEBUG:--all}
    export WINEFSYNC=${WINEFSYNC:-1}
    # Without the descriptor-heap path vkd3d-proton caps shader-visible view
    # heaps at 1,000,000 descriptors; titles that ask for more fault the GPU.
    export VKD3D_CONFIG=${VKD3D_CONFIG-descriptor_heap}
    export RUST_LOG=${RUST_LOG:-info}

    local sandbox=()
    if sandbox_ok; then
        sandbox=(bwrap --dev-bind / / --ro-bind "$GAME_DIR" "$GAME_DIR" --)
    elif [[ ${VP_SANDBOX:-1} != 0 ]]; then
        die "bubblewrap cannot create a sandbox here (see the README, \"Troubleshooting\"). VP_SANDBOX=0 runs without it, with the game folder writable"
    else
        warn "running without the sandbox: the game folder is not protected"
    fi
    # The patched wineserver (see "wineserver" above), through the copy of
    # Proton that has it. Wine reuses a server already running for the
    # prefix, so stop any: the one wine starts now runs inside the sandbox
    # (it opens files for the title, so it must see the game folder
    # read-only too) and is the right one.
    local ws; ws=$(wanted_wineserver)
    [[ -n $ws ]] && use_wineserver "$ws"
    "$PROTON_DIR/files/bin/wineserver" -k 2>/dev/null || true
    export VICTORY_GAME_DIR VICTORY_CACHE_DIR VICTORY_DATA_DIR
    VICTORY_GAME_DIR=$(winpath "$GAME_DIR")
    VICTORY_CACHE_DIR=$(winpath "$PDATA/cache")
    VICTORY_DATA_DIR=$(winpath "$PDATA/data")
    local wrap=()   # VP_WRAP: a command to run wine under, for diagnostics
    [[ -n ${VP_WRAP:-} ]] && read -r -a wrap <<<"$VP_WRAP"

    local log; log=$PDATA/logs/$(date +%Y%m%d-%H%M%S)-$label.log
    ln -sfn "$(basename "$log")" "$PDATA/logs/latest.log"
    ln -sfn "profiles/$PROFILE/logs/$(basename "$log")" "$DATA/latest.log"
    info "profile $PROFILE ($(git -C "$SRC" log -1 --format=%h 2>/dev/null || echo '?')), $(proton_tag), wineserver: ${ws:-stock}"
    [[ -n $penv ]] && info "with $penv"
    info "log: $log"
    local thp_pid=
    if thp_ready; then thp_watch "$log" & thp_pid=$!; fi
    cd "$PDATA"
    set +e
    ${sandbox[@]+"${sandbox[@]}"} ${wrap[@]+"${wrap[@]}"} \
        "$PROTON_DIR/files/bin/wine" "$EXE" "$@" 2>&1 | tee "$log"
    local rc=${PIPESTATUS[0]}
    [[ -n $thp_pid ]] && kill "$thp_pid" 2>/dev/null
    set -e
    info "victory.exe exited with code $rc$( ((rc > 128)) && printf ' (signal %d)' $((rc - 128)))" 2>&1 | tee -a "$log" >&2
    grep -aq 'GPUVM fault' "$log" && warn "the GPU faulted (GPUVM fault); see the README, \"Troubleshooting\""
    grep -aq 'unhandled exception' "$log" && warn "the game stopped on an exception; crash reports in $PDATA/data/*/crashes.log"
    return "$rc"
}

# The native build: the same sandbox and per-profile folders, Linux paths,
# no wine.
launch_native() {
    local label=$1; shift
    require_game
    mkdir -p "$PDATA/cache" "$PDATA/data" "$PDATA/logs"
    export VICTORY_VKD3D=${VICTORY_VKD3D:-$(vkd3d_lib)}
    [[ -n $VICTORY_VKD3D ]] || die "native vkd3d-proton is missing (victory-proton vkd3d)"
    local penv; penv=$(profile_vars)
    export_profile_vars
    export VKD3D_CONFIG=${VKD3D_CONFIG-descriptor_heap}
    export VKD3D_SHADER_CACHE_PATH=${VKD3D_SHADER_CACHE_PATH:-$PDATA}
    export RUST_LOG=${RUST_LOG:-info}
    local sandbox=()
    if sandbox_ok; then
        sandbox=(bwrap --dev-bind / / --ro-bind "$GAME_DIR" "$GAME_DIR" --)
    elif [[ ${VP_SANDBOX:-1} != 0 ]]; then
        die "bubblewrap cannot create a sandbox here (see the README, \"Troubleshooting\"). VP_SANDBOX=0 runs without it, with the game folder writable"
    else
        warn "running without the sandbox: the game folder is not protected"
    fi
    export VICTORY_GAME_DIR=$GAME_DIR VICTORY_CACHE_DIR=$PDATA/cache VICTORY_DATA_DIR=$PDATA/data
    local wrap=()
    [[ -n ${VP_WRAP:-} ]] && read -r -a wrap <<<"$VP_WRAP"
    local log; log=$PDATA/logs/$(date +%Y%m%d-%H%M%S)-$label.log
    ln -sfn "$(basename "$log")" "$PDATA/logs/latest.log"
    ln -sfn "profiles/$PROFILE/logs/$(basename "$log")" "$DATA/latest.log"
    info "profile $PROFILE ($(git -C "$SRC" log -1 --format=%h 2>/dev/null || echo '?')), native, vkd3d-proton: $VICTORY_VKD3D"
    [[ -n $penv ]] && info "with $penv"
    info "log: $log"
    cd "$PDATA"
    set +e
    ${sandbox[@]+"${sandbox[@]}"} ${wrap[@]+"${wrap[@]}"} "$EXE" "$@" 2>&1 | tee "$log"
    local rc=${PIPESTATUS[0]}
    set -e
    info "victory exited with code $rc$( ((rc > 128)) && printf ' (signal %d)' $((rc - 128)))" 2>&1 | tee -a "$log" >&2
    grep -aq 'GPUVM fault' "$log" && warn "the GPU faulted (GPUVM fault); see the README, \"Troubleshooting\""
    return "$rc"
}

run_game() {
    local do_update=1 args=()
    while (($#)); do
        case $1 in
            --no-update|-n) do_update=0 ;;
            --) shift; args=(-- "$@"); break ;;
            *) args+=("$1") ;;
        esac
        shift
    done
    running && die "VIctory is running already; close it first (victory-proton kill)"
    gpu_check
    require_game
    ((do_update)) && update
    build
    if ((NATIVE)); then
        vkd3d_ready
        info "starting $GAME_EXE natively, without wine"
        launch run run "$GAME_DIR/$GAME_EXE" --execute "${args[@]}"
        return
    fi
    prefix
    d3dcompiler
    ((do_update)) && check_proton
    ensure_wineserver
    thp_hint
    info "starting $GAME_EXE (the window is called VIctory)"
    launch run run "$(winpath "$GAME_DIR/$GAME_EXE")" --execute "${args[@]}"
}

# ---------------------------------------------------------------- status
status() {
    local ok="${c_info}ok$c_off" no="${c_warn}no$c_off" dir
    printf 'profile     %s  %s %s\n' "$PROFILE" "$UPSTREAM" "$BRANCH"
    printf 'checkout    %s %s\n' "$SRC" "$(git -C "$SRC" log -1 --format='(%h %cd)' --date=short 2>/dev/null || echo '(not cloned yet)')"
    dir=$(game_dir)
    if [[ -n $dir ]]; then printf 'game        %s  (%s)\n' "$dir" "$(game_exe "$dir" 2>/dev/null || echo 'no executable found')"
    else printf 'game        %s (victory-proton game)\n' "$no"; fi
    if ((NATIVE)); then
        printf 'runtime     native Linux (no wine)\n'
        printf 'vkd3d       %s\n' "$( [[ -n ${VICTORY_VKD3D:-} ]] && echo "$ok $VICTORY_VKD3D" || { [[ -n $(vkd3d_lib) ]] && echo "$ok $(vkd3d_lib)"; } || echo "$no not built (victory-proton vkd3d)")"
    else
        PROTON_DIR=$( (find_proton 2>/dev/null; printf '%s' "$PROTON_DIR") || true)
        if [[ -n $PROTON_DIR ]]; then
            printf 'proton      %s  %s%s\n' "$(proton_tag)" "$PROTON_DIR" "$([[ -n $PROTON_WHICH ]] && echo "  (set: $PROTON_WHICH)")"
            printf 'prefix      %s\n' "$PREFIX_ROOT"
            printf 'wineserver  %s\n' "$([[ -n $(wanted_wineserver) ]] && echo "$ok patched ($(wanted_wineserver))" || echo "$no stock ($(proton_source "$(proton_tag | sed 's/-x86_64.*//')" >/dev/null && echo 'built on the next run, or: victory-proton wineserver' || echo 'no known sources for this Proton'))")"
            if [[ -n $(thp_src) ]]; then
                printf 'huge pages  %s\n' "$(thp_has_cap && echo "$ok ($THP_HELPER)" || echo "$no off (victory-proton thp)")"
            fi
        else printf 'proton      %s (victory-proton proton)\n' "$no"; fi
        printf 'd3dcompiler %s\n' "$(d3dcompiler_native && echo "$ok Microsoft's" || echo "$no wine's (installed on the next run)")"
    fi
    printf 'gpu         %s\n' "$(gpu_vendor)"
    printf 'variables   %s\n' "$(profile_vars)"
    printf 'sandbox     %s\n' "$(sandbox_ok && echo "$ok (game folder read-only)" || echo "$no")"
    printf 'data        %s\n' "$DATA"
    printf 'config      %s\n' "$CONFIG_DIR"
}

# ---------------------------------------------------------------- setup
setup() {
    need git curl bwrap winetricks clang lld-link
    ((NATIVE)) || need "${WS_DEPS[@]}"
    if ! command -v rustup >/dev/null; then
        info "installing rustup into ~/.cargo (your PATH and shell profile are left alone)"
        curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain none --profile minimal
    fi
    if ! command -v cargo-xwin >/dev/null; then
        info "installing cargo-xwin (fetches the Windows CRT and SDK when building)"
        rustup toolchain install stable --profile minimal
        cargo +stable install --locked cargo-xwin
    fi
    [[ -n $(list_ge) || -n $PROTON_DIR ]] || install_proton
    find_proton
    info "Proton: $(proton_tag) ($PROTON_DIR)"
    sandbox_ok || warn "bubblewrap cannot create a sandbox here; see the README, \"Troubleshooting\""
    [[ -n $(game_dir) ]] || pick_game
    update
    build
    ((NATIVE)) && vkd3d_ready
    prefix
    d3dcompiler
    if ! command -v victory-proton >/dev/null && [[ ! -e $HOME/.local/bin/victory-proton ]]; then
        mkdir -p "$HOME/.local/bin"
        ln -s "$REPO_DIR/victory-proton" "$HOME/.local/bin/victory-proton"
        info "linked ~/.local/bin/victory-proton to this script"
    fi
    if ((!NATIVE)); then
        ensure_wineserver
        if [[ -n $(thp_src) && ${VICTORY_THP:-1} != 0 ]] && ! thp_has_cap; then
            if [[ -t 0 ]]; then thp_setup || warn "huge pages stay off; 'victory-proton thp' tries again"
            else warn "huge pages are off: run 'victory-proton thp' once (asks for sudo)"; fi
        fi
    fi
    info "ready. Run: victory-proton"
}

usage() {
    cat <<EOF
victory-proton: run Xbox Series titles with VIctory on Linux, through GE-Proton

  victory-proton [-p PROFILE] [run] [--no-update] [-- game args]
                          update the profile's VIctory, build it if needed, run the game
  victory-proton setup    install the tools, pick the game, clone, build, set up wine
  victory-proton game [PATH|pick]
                          show or set the game folder (the one with MicrosoftGame.config)
  victory-proton profile  list the VIctory repositories you can run
  victory-proton profile NAME                       make NAME the default
  victory-proton profile add URL [NAME] [BRANCH] [VAR=VALUE ...]
                                                    add a fork (github.com/o/r/tree/branch works)
  victory-proton profile remove NAME
  victory-proton profile proton NAME [PROTON|default]
                          run a profile with another Proton (see: victory-proton proton list)
  victory-proton -p NAME|URL ...                    use another profile for one command
  victory-proton wineserver  build the faster wineserver for your GE-Proton (run does it once by itself)
  victory-proton thp      set up huge pages for profiles that use them (kroeeee; asks for sudo once)
  victory-proton vkd3d    build native vkd3d-proton, for native profiles (done on first run)
  victory-proton proton [TAG]  install the newest GE-Proton (or TAG)
  victory-proton proton list   every Proton found (GE, Steam's, CachyOS, ...)
  victory-proton update | build   only update, or only build
  victory-proton status   what is set up and what is missing
  victory-proton log      the last run's log
  victory-proton kill     close the game
  victory-proton victory ARGS  run victory.exe with any of its own commands

Profile now: $PROFILE ($UPSTREAM $BRANCH)
Settings: VP_* variables, in the environment or in $CONFIG_DIR/config (see the README).
EOF
}

cmd=${1:-run}
[[ $# -gt 0 ]] && shift
case $cmd in
    run)        run_game "$@" ;;
    setup)      setup ;;
    game)       game_cmd "$@" ;;
    profile|profiles) profile_cmd "$@" ;;
    wineserver) build_wineserver ;;
    thp)        thp_setup ;;
    vkd3d)      build_vkd3d ;;
    proton)     if [[ ${1:-} == list ]]; then proton_list; else install_proton "$@"; fi ;;
    update)     update ;;
    build)      build "$@" ;;
    status)     status ;;
    log|logs)   [[ -e $DATA/latest.log ]] || die "no runs yet"; echo "$(readlink -f "$DATA/latest.log")"; tail -n "${1:-40}" "$DATA/latest.log" ;;
    kill)       if pkill -f "$PROC_RE"; then info "game closed"; else info "it was not running"; fi ;;
    victory)    [[ -f $EXE ]] || build; prefix; ((NATIVE)) && vkd3d_ready; launch tool "$@" ;;
    help|-h|--help) usage ;;
    -*)         run_game "$cmd" "$@" ;;
    *)          usage >&2; exit 1 ;;
esac
